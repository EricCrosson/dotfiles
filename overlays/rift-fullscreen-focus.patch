+/// Corrective raise batches for a stacked container's cascade.
+///
+/// `members` lists the container's windows in slot order (their frames step
+/// through the container by `stack_offset`, so a member's slot decides which
+/// side of it shows an edge). `focused` is the member that just took (or is
+/// about to take) focus and must end on top; `current` lists the members in
+/// their current z-order, front to back. Returns same-app runs in
+/// chronological raise order — each app raises its list in order, last on
+/// top — and whether the focused window must be (re)raised last to end on
+/// top.
+///
+/// A raise moves a window above everything, so exactly a bottom suffix of
+/// the target order can be kept; the rest are raised in reverse target
+/// order. A cascade is left untouched when it already keeps every edge
+/// visible, and also when the pending focus raise alone would: the focused
+/// window above every member is simulated and checked before any
+/// corrective is planned.
+pub(crate) fn corrective_restack_plan(
+    members: &[WindowId],
+    focused: WindowId,
+    current: &[WindowId],
+) -> (Vec<Vec<WindowId>>, bool) {
+    let slots: HashMap<WindowId, usize> =
+        members.iter().enumerate().map(|(slot, wid)| (*wid, slot)).collect();
+    let Some(&focused) = slots.get(&focused) else {
+        return (Vec::new(), false);
+    };
+    let focused_wid = members[focused];
+    let needs_focus_raise = current.first() != Some(&focused_wid);
+    // The focus raise moves the focused window above every member; when the
+    // cascade it would produce keeps every edge visible, no corrective is
+    // needed and the focus raise alone finishes the restack.
+    let mut after_focus_raise = Vec::with_capacity(current.len());
+    after_focus_raise.push(focused_wid);
+    after_focus_raise.extend(current.iter().copied().filter(|wid| *wid != focused_wid));
+    if cascade_edges_all_visible(&slots, &after_focus_raise) {
+        return (Vec::new(), needs_focus_raise);
+    }
+
+    let target = crate::layout_engine::canonical_stack_z_order(members, focused_wid);
+    let others_target = &target[1..];
+    let others_current: Vec<WindowId> =
+        current.iter().copied().filter(|wid| *wid != focused_wid).collect();
+
+    // Members already sitting in their final relative order as the bottom of
+    // the stack need no raise; find the longest such target suffix.
+    let mut keep = 0;
+    for suffix in (1..=others_target.len()).rev() {
+        let start = others_target.len() - suffix;
+        let mut cursor = 0;
+        let mut matched = true;
+        for wanted in &others_target[start..] {
+            let Some(offset) = others_current[cursor..].iter().position(|wid| wid == wanted) else {
+                matched = false;
+                break;
+            };
+            cursor += offset + 1;
+        }
+        if matched {
+            keep = suffix;
+            break;
+        }
+    }
+
+    let raise_count = others_target.len() - keep;
+    let chronological: Vec<WindowId> = others_target[..raise_count].iter().rev().copied().collect();
+    let mut runs: Vec<Vec<WindowId>> = Vec::new();
+    for wid in chronological {
+        match runs.last_mut() {
+            Some(run) if run.last().is_some_and(|last| last.pid == wid.pid) => run.push(wid),
+            _ => runs.push(vec![wid]),
+        }
+    }
+
+    // A raise lands above the focused window, and the planned focus raise
+    // must be the last touch of the cascade.
+    (runs, true)
+}
+
+/// Whether every member of `current` (front to back) keeps a visible edge:
+/// the members above any one of them must all sit on the same side of its
+/// slot, since a lower-slot cover hides the right edge and a higher-slot
+/// cover hides the left edge. Members covered from both sides are fully
+/// hidden.
+fn cascade_edges_all_visible(slots: &HashMap<WindowId, usize>, current: &[WindowId]) -> bool {
+    for (position, wid) in current.iter().enumerate() {
+        let Some(&slot) = slots.get(wid) else { return false };
+        let mut saw_lower = false;
+        let mut saw_higher = false;
+        for above in &current[..position] {
+            let Some(&above_slot) = slots.get(above) else {
+                return false;
+            };
+            saw_lower |= above_slot < slot;
+            saw_higher |= above_slot > slot;
+        }
+        if saw_lower && saw_higher {
+            return false;
+        }
+    }
+    true
+}
