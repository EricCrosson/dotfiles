+        // The user is typing in slack: macOS focus and the tree selection
+        // both point at slack.
+        let _ = engine.handle_event(&mut window_store, LayoutEvent::WindowFocused(space, slack));
+        assert_eq!(engine.selected_window(space), Some(slack));
