+    /// Waits up to five seconds for the next request on `rx`.
+    fn next_request_within(rx: &mut crate::actor::Receiver<Request>) -> Option<Request> {
+        let start = Instant::now();
+        while start.elapsed() < Duration::from_secs(5) {
+            if let Ok((_, request)) = rx.try_recv() {
+                return Some(request);
+            }
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        None
+    }
