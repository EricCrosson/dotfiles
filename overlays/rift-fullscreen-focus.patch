+    // and a click on window 1 (left slot) leaves z [1, 2, 3] — the z-order
+    // the reader sees, with window 3 (middle slot) buried under both sides
+    // of its frame. Rift raises window 3 first, then window 1 last.
+    let (_, mut reactor, mut raise_rx) = stack_reactor_with_z(
+        WindowId::new(1, 2),
+        &[
+            WindowId::new(1, 1),
+            WindowId::new(1, 2),
