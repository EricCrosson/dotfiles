+    #[test]
+    fn layout_mode_switch_preserves_window_order() {
+        let mut window_store = WindowStore::default();
+        let mut settings = LayoutSettings::default();
+        settings.mode = LayoutMode::Traditional;
+        let mut engine = LayoutEngine::new(&VirtualWorkspaceSettings::default(), &settings, None);
+        let space = SpaceId::new(96);
+        let w1 = WindowId::new(1, 1);
+        let w2 = WindowId::new(1, 2);
+
+        let _ = engine.handle_event(
+            &mut window_store,
+            LayoutEvent::SpaceExposed(space, CGSize::new(1728.0, 1083.0)),
+        );
+        let _ = engine.handle_event(
+            &mut window_store,
+            LayoutEvent::windows_observed(
+                space,
+                1,
+                vec![
+                    window_layout_info(w1, CGSize::new(864.0, 1083.0)),
+                    window_layout_info(w2, CGSize::new(864.0, 1083.0)),
+                ],
+                None,
+            ),
+        );
+
+        // The user is typing in the second window.
+        let _ = engine.handle_event(&mut window_store, LayoutEvent::WindowFocused(space, w2));
+        let (workspace, layout) = engine.workspaces.active_layout_for_space(space).unwrap();
+
+        // A stack↔traditional round trip (e.g. a set-layout macro) must not
+        // reorder siblings: the rebuild previously iterated
+        // visible_windows_in_layout, which visits a stack group's selected
+        // member first and moved the focused window into the first slot.
+        assert!(engine.switch_workspace_layout_mode(
+            &window_store,
+            space,
+            workspace,
+            LayoutMode::Stack,
+        ));
+        assert!(engine.switch_workspace_layout_mode(
+            &window_store,
+            space,
+            workspace,
+            LayoutMode::Traditional,
+        ));
+
+        let (_, layout) = engine.workspaces.active_layout_for_space(space).unwrap();
+        assert_eq!(
+            engine.workspaces[workspace].layout_system.all_windows_in_layout(layout),
+            vec![w1, w2],
+            "focused window must keep its original sibling position"
+        );
+        // Focus is preserved across the rebuild.
+        assert_eq!(engine.selected_window(space), Some(w2));
+    }
