+#[test]
+fn raise_timeout_retries_the_dropped_corrective_raises() {
+    // A slow app can hang its corrective raise past the raise manager's
+    // timeout: the sequence is cancelled and only the focus is delivered,
+    // leaving the cascade buried. The reactor must retry the plan.
+    let (_, mut reactor, mut raise_rx) = stack_reactor_with_z(
+        WindowId::new(1, 2),
+        &[
+            WindowId::new(1, 1),
+            WindowId::new(1, 2),
+            WindowId::new(1, 3),
+        ],
+        false,
+    );
+    reactor.handle_event(Event::WindowServerFocusChanged(
+        WindowId::new(1, 1),
+        SpaceId::new(1),
+    ));
+    let first = raise_requests(&mut raise_rx);
+    assert_eq!(first.len(), 3, "{first:?}");
+    assert_eq!(first[0].raise_windows, vec![vec![WindowId::new(1, 3)]]);
+
+    reactor.handle_event(Event::RaiseTimeout { sequence_id: 1 });
+    let retried = raise_requests(&mut raise_rx);
+    // The relayed RaiseTimeout is not a RaiseRequest; the retry replans and
+    // raises window 3 again, then re-focuses window 1.
+    assert_eq!(retried.len(), 3, "{retried:?}");
+    assert_eq!(retried[0].raise_windows, vec![vec![WindowId::new(1, 3)]]);
+    assert!(retried[0].focus_window.is_none());
+    assert_eq!(
+        retried[1].focus_window.map(|(wid, _)| wid),
+        Some(WindowId::new(1, 1))
+    );
