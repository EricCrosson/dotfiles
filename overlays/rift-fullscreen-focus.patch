+#[test]
+fn fullscreen_toggles_apply_instantly_in_both_directions() {
+    let (mut apps, mut reactor) = test_context();
+    let screen = CGRect::new(CGPoint::new(0., 0.), CGSize::new(1000., 1000.));
+    let space = SpaceId::new(1);
+    apps.make_app_and_settle_on_screen(&mut reactor, screen, space, 1, make_windows(1));
+    apps.requests();
+    // Every interpolated frame of a toggle is another split position/size
+    // write, so toggles skip the animation whatever the animate setting.
+    for direction in ["enter", "exit"] {
+        let outcome = reactor.dispatch_test_layout_command(LayoutCommand::ToggleFullscreen);
+        assert_eq!(
+            outcome.arrange.passes, 1,
+            "{direction} must reconcile window frames"
+        );
+        assert!(outcome.arrange.is_resize, "{direction} must apply instantly");
+    }
+    let outcome = reactor.dispatch_test_layout_command(LayoutCommand::MoveNode(Direction::Left));
+    assert!(
+        !outcome.arrange.is_resize,
+        "ordinary geometry commands keep their animation"
+    );
+}
+
+#[test]
+fn scrolling_fullscreen_exit_raises_nothing() {
+    let (mut apps, mut reactor) = test_context();
+    let screen = CGRect::new(CGPoint::new(0., 0.), CGSize::new(1000., 1000.));
+    let space = SpaceId::new(1);
+    apps.make_app_and_settle_on_screen(&mut reactor, screen, space, 1, make_windows(2));
+    apps.requests();
+    reactor.handle_test_layout_command(LayoutCommand::SetWorkspaceLayout {
+        workspace: None,
