+    // The dropped plan is re-armed, not lost: once the storm window closes,
+    // the next layout response corrects the cascade without another focus
+    // change. (Window 3 now holds focus; the focus raise alone sorts it, so
+    // the plan needs only the focus request — the trailing request is the
+    // empty response itself.)
+    reactor.last_raise_request_sent_at = None;
+    reactor.handle_layout_response(layout::EventResponse::default(), None);
+    let retried = raise_requests(&mut raise_rx);
+    assert_eq!(retried.len(), 2, "{retried:?}");
+    assert!(retried[0].raise_windows.is_empty());
+    assert_eq!(
+        retried[0].focus_window.map(|(wid, _)| wid),
+        Some(WindowId::new(1, 3))
+    );
+    assert!(retried[1].raise_windows.is_empty());
+    assert!(retried[1].focus_window.is_none());
+}
