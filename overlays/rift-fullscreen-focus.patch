+/// A three-window stack on space 1 (slots hold [1, 3, 2]), entered with the
+/// window-server z-order overridden to `z_order` (window ids, front to
+/// back), with raise requests captured. `capture_entry` attaches the capture
+/// before the layout switch so the entry's own raise requests are observed.
+fn stack_reactor_with_z(
+    focused: WindowId,
+    z_order: &[WindowId],
+    capture_entry: bool,
+) -> (Apps, Reactor, actor::Receiver<raise_manager::Event>) {
+    let (mut apps, mut reactor) = test_context();
+    let screen = CGRect::new(CGPoint::new(0., 0.), CGSize::new(1000., 1000.));
+    let space = SpaceId::new(1);
+    reactor.handle_event(space_state_event(vec![screen], vec![Some(space)]));
+    make_active_app(&mut apps, &mut reactor, 1, make_windows(3), Some(focused));
+    apps.simulate_until_quiet(&mut reactor);
+    let z: Vec<u32> =
+        z_order.iter().map(|wid| reactor.test_window_server_id(*wid).as_u32()).collect();
+    window_server::set_space_window_list_for_connection_override(Some(z));
+    let (raise_tx, mut raise_rx) = actor::channel();
+    reactor.communication_manager.raise_manager_tx = raise_tx;
+    if capture_entry {
+        // Tests drive events within microseconds; the entry plan must not
+        // see the setup's raises as an in-flight storm.
+        reactor.last_raise_request_sent_at = None;
+    }
+    reactor.handle_test_layout_command(LayoutCommand::SetWorkspaceLayout {
+        workspace: None,
+        mode: LayoutMode::Stack,
+    });
+    let entry_requests = apps.requests();
+    for event in apps.simulate_events_for_requests(entry_requests) {
+        reactor.handle_event(event);
+    }
+    apps.simulate_until_quiet(&mut reactor);
+    if !capture_entry {
+        // The entry's raise requests belong to the setup, not the test.
+        while raise_rx.try_recv().is_ok() {}
+        // Lift the storm window the entry left open so tests can click.
+        reactor.last_raise_request_sent_at = None;
+    }
+    (apps, reactor, raise_rx)
+}
+
+fn raise_requests(
+    raise_rx: &mut actor::Receiver<raise_manager::Event>,
+) -> Vec<raise_manager::RaiseRequest> {
+    std::iter::from_fn(|| raise_rx.try_recv().ok())
+        .filter_map(|(_, event)| match event {
+            raise_manager::Event::RaiseRequest(request) => Some(request),
+            _ => None,
+        })
+        .collect()
+}
