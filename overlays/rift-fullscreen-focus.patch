+#[test]
+fn fullscreen_toggle_directions_pick_their_arrange_mode() {
+    let (mut apps, mut reactor) = test_context();
+    let screen = CGRect::new(CGPoint::new(0., 0.), CGSize::new(1000., 1000.));
+    let space = SpaceId::new(1);
+    apps.make_app_and_settle_on_screen(&mut reactor, screen, space, 1, make_windows(1));
+    apps.requests();
+    // Entering fullscreen keeps the (unavoidable) position-write tear visible
+    // as a discrete flash, so the enter direction animates: the interpolation
+    // presents the same exposure as deliberate motion instead.
+    let enter = reactor.dispatch_test_layout_command(LayoutCommand::ToggleFullscreen);
+    assert_eq!(enter.arrange.passes, 1, "enter must reconcile window frames");
+    assert!(
+        !enter.arrange.is_resize && enter.arrange.animate,
+        "fullscreen enter must animate instead of exposing the position-write \
+         tear as a discrete flash"
+    );
+    // Exiting fullscreen is tear-free at instant speed once the write order
+    // moves position before size (the intermediate overhangs off-screen), so
+    // exit stays instant.
+    let exit = reactor.dispatch_test_layout_command(LayoutCommand::ToggleFullscreen);
+    assert_eq!(exit.arrange.passes, 1, "exit must reconcile window frames");
+    assert!(
+        exit.arrange.is_resize && !exit.arrange.animate,
+        "fullscreen exit must apply its frames instantly: the position-first \
+         write order already hides the intermediate"
+    );
+    let outcome = reactor.dispatch_test_layout_command(LayoutCommand::MoveNode(Direction::Left));
+    assert!(
+        !outcome.arrange.is_resize && !outcome.arrange.animate,
+        "ordinary geometry commands keep their animation"
+    );
+}
+
+#[test]
+fn fullscreen_toggle_directions_hold_in_scrolling_layouts() {
+    let (mut apps, mut reactor) = test_context();
+    let screen = CGRect::new(CGPoint::new(0., 0.), CGSize::new(1000., 1000.));
+    let space = SpaceId::new(1);
+    apps.make_app_and_settle_on_screen(&mut reactor, screen, space, 1, make_windows(2));
+    apps.requests();
+    reactor.handle_test_layout_command(LayoutCommand::SetWorkspaceLayout {
+        workspace: None,
+        mode: LayoutMode::Scrolling,
+    });
+    // The scrolling layout system reports the raised window on both toggle
+    // directions; the engine must normalize the exit response so the reactor
+    // keeps exit instant and only animates the entry.
+    let enter = reactor.dispatch_test_layout_command(LayoutCommand::ToggleFullscreen);
+    assert!(
+        !enter.arrange.is_resize && enter.arrange.animate,
+        "scrolling fullscreen enter must animate"
+    );
+    let exit = reactor.dispatch_test_layout_command(LayoutCommand::ToggleFullscreen);
+    assert!(
+        exit.arrange.is_resize && !exit.arrange.animate,
+        "scrolling fullscreen exit must stay instant: normalizing the exit \
+         response keeps the direction detectable across layout systems"
+    );
+}
