+/// Orders the instant writes of an arrange whose windows overlap before or
+/// after it, so no window is caught mid-write in front of the old or the new
+/// view (see [`Animation::skip_to_end`]).
+#[derive(Debug)]
+struct WriteStage {
+    /// The window that ends up in front: the arrange's selection.
+    foreground: WindowId,
+    /// Window-server ids of the arranged windows, to see a stage land.
+    server_ids: HashMap<WindowId, WindowServerId>,
+}
+
+impl WriteStage {
+    /// Split `windows` into the writes to send first and the ones to send
+    /// once those have landed. A growing foreground goes first: it covers the
+    /// background windows while they move. A shrinking one goes last: it
+    /// reveals background windows already in place. `None` when there is
+    /// nothing to order.
+    fn split<'a>(
+        &self,
+        windows: &'a [PresentedWindow],
+    ) -> Option<(Vec<&'a PresentedWindow>, Vec<&'a PresentedWindow>)> {
+        let foreground = windows.iter().find(|window| window.wid == self.foreground)?;
+        let background: Vec<_> =
+            windows.iter().filter(|window| window.wid != self.foreground).collect();
+        if background.is_empty() {
+            return None;
+        }
+        let area = |rect: CGRect| rect.size.width * rect.size.height;
+        Some(if area(foreground.to) >= area(foreground.from) {
+            (vec![foreground], background)
+        } else {
+            (background, vec![foreground])
+        })
+    }
+}
+
+/// How long a staged arrange waits for its first stage to reach the screen
+/// before writing the rest anyway: an unresponsive app must not strand them.
+#[cfg_attr(test, allow(dead_code))]
+const STAGE_DEADLINE: Duration = Duration::from_millis(150);
+
+/// Send `then` once every first-stage window shows its target on screen.
+#[cfg(not(test))]
+fn release_when_landed(
+    landed: Vec<(WindowServerId, CGRect)>,
+    then: Vec<(AppThreadHandle, Request)>,
+) {
+    release_when(
+        landed,
+        then,
+        crate::sys::window_server::window_bounds,
+        STAGE_DEADLINE,
+    );
+}
+
+/// Tests have no window server: the stages are sent in order, immediately.
+#[cfg(test)]
+fn release_when_landed(
+    _landed: Vec<(WindowServerId, CGRect)>,
+    then: Vec<(AppThreadHandle, Request)>,
+) {
+    for (handle, request) in then {
+        _ = handle.send(request);
+    }
+}
+
+/// Send `then` once `bounds` reports every `landed` window at its target, or
+/// once `deadline` passes.
+fn release_when(
+    landed: Vec<(WindowServerId, CGRect)>,
+    then: Vec<(AppThreadHandle, Request)>,
+    bounds: impl Fn(WindowServerId) -> Option<CGRect> + Send + 'static,
+    deadline: Duration,
+) {
+    let release = move || {
+        let start = Instant::now();
+        while !landed
+            .iter()
+            .all(|&(wsid, target)| bounds(wsid).is_some_and(|frame| frame.same_as(target)))
+        {
+            if start.elapsed() >= deadline {
+                debug!(?deadline, "Staged arrange: first stage did not land in time");
+                break;
+            }
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        for (handle, request) in then {
+            _ = handle.send(request);
+        }
+    };
+    if let Err(err) = std::thread::Builder::new().name("rift-frame-stage".into()).spawn(release) {
+        warn!(?err, "Failed to start a staged arrange's second stage");
+    }
 }
 
