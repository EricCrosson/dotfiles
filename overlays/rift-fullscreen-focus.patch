+fn write_frame(elem: &AXUIElement, _current: Option<CGRect>, target: CGRect) {
+    // Always write position before size: growing with an unchanged origin
+    // would clamp the size to the screen edge, and when shrinking the
+    // position-first intermediate keeps the old, wider frame, which
