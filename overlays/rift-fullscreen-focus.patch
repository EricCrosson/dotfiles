+    #[test]
+    fn staged_release_waits_for_the_first_stage_to_land() {
+        use std::sync::atomic::{AtomicBool, Ordering};
+
+        let (tx, mut rx) = crate::actor::channel();
+        let handle = AppThreadHandle::new_for_test(tx);
+        let target = rect(40.0, 0.0, 960.0, 1000.0);
+        let landed = Arc::new(AtomicBool::new(false));
+        let bounds = {
+            let landed = landed.clone();
+            move |_| {
+                Some(if landed.load(Ordering::SeqCst) {
+                    target
+                } else {
+                    rect(500.0, 0.0, 500.0, 1000.0)
+                })
+            }
+        };
+        let write =
+            Request::set_window_frame(WindowId::new(1, 1), target, TransactionId::default(), true);
+        release_when(
+            vec![(WindowServerId::new(7), target)],
+            vec![(handle, write)],
+            bounds,
+            Duration::from_secs(60),
+        );
+
+        std::thread::sleep(Duration::from_millis(30));
+        assert!(
+            rx.try_recv().is_err(),
+            "the second stage must wait for the first to land"
+        );
+        landed.store(true, Ordering::SeqCst);
+        assert!(
+            matches!(next_request_within(&mut rx), Some(Request::SetWindowFrames(..))),
+            "the second stage must follow once the first lands"
+        );
+    }
+
