+
+/// Windows of full-frame writes, in request order.
+fn frame_write_order(requests: &[Request]) -> Vec<WindowId> {
+    requests
+        .iter()
+        .flat_map(|request| match request {
+            Request::SetWindowFrames(frames, _, crate::actor::app::FrameMode::Full, _) => {
+                frames.iter().map(|(wid, _)| *wid).collect()
+            }
+            _ => vec![],
+        })
+        .collect()
+}
