+#[test]
+fn clicks_within_a_raise_storm_do_not_fight_the_raise_in_flight() {
+    // The first click starts a raise sequence; a second click arriving while
+    // raises are still in flight must not plan against transient key windows.
+    let (_, mut reactor, mut raise_rx) = stack_reactor_with_z(
+        WindowId::new(1, 2),
+        &[
+            WindowId::new(1, 2),
+            WindowId::new(1, 3),
+            WindowId::new(1, 1),
+        ],
+        false,
+    );
+    reactor.handle_event(Event::WindowServerFocusChanged(
+        WindowId::new(1, 1),
+        SpaceId::new(1),
+    ));
+    let storm_requests = raise_requests(&mut raise_rx);
+    assert_eq!(storm_requests.len(), 3, "{storm_requests:?}");
+
+    // The corrective raises keep the storm window open; the second click's
+    // plan is dropped instead of racing the raises in flight.
+    reactor.handle_event(Event::WindowServerFocusChanged(
+        WindowId::new(1, 3),
+        SpaceId::new(1),
+    ));
+    assert!(raise_requests(&mut raise_rx).is_empty());
