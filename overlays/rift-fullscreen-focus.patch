+/// Z-order (front to back) that keeps every member of a stacked container
+/// visible: the focused member on top, then the remaining members ordered
+/// outward from the focused one, nearest first. Windows left of the focused
+/// one cascade leftward and windows right of it rightward, so each shows a
+/// strip of its edge; windows on one side never bury a window on the other.
+pub(crate) fn canonical_stack_z_order(members: &[WindowId], focused: WindowId) -> Vec<WindowId> {
+    let Some(focused_idx) = members.iter().position(|&member| member == focused) else {
+        return Vec::new();
+    };
+    let mut order = Vec::with_capacity(members.len());
+    order.push(focused);
+    let mut left = focused_idx;
+    let mut right = focused_idx;
+    while left > 0 || right + 1 < members.len() {
+        if left > 0 {
+            left -= 1;
+            order.push(members[left]);
+        }
+        if right + 1 < members.len() {
+            right += 1;
+            order.push(members[right]);
+        }
+    }
+    order
+}
