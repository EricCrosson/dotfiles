+    let enter = reactor.dispatch_test_layout_command(LayoutCommand::ToggleFullscreen);
+    assert!(
+        enter.arrange.is_resize,
+        "scrolling fullscreen enter must apply instantly"
+    );
+    // The scrolling system reported the toggled window on both directions;
+    // the engine normalizes the exit so it does not re-raise (and thereby
+    // re-activate) a window that is already in front.
+    let exit = reactor.dispatch_test_layout_command(LayoutCommand::ToggleFullscreen);
