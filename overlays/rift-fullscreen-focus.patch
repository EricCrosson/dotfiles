+            // Fullscreen must follow the active window: the response raises
+            // the toggled window, and raising activates it, so raising
+            // ghostty here would fullscreen and activate the wrong window.
+            assert_eq!(response.raise_windows, vec![slack]);
+            assert_eq!(engine.selected_window(space), Some(slack));
